<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:context=".MainActivity">

    <!-- Top Context & Clock Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintEnd_toStartOf="@+id/waveGestureView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:shadowColor="#80000000"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:text="10:09"
            android:textColor="@color/text_primary"
            android:textSize="54sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#80000000"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:text="Tuesday, June 2"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtWeather"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#80000000"
                android:shadowDy="1"
                android:shadowRadius="6"
                android:text="☀️ 22°C"
                android:textColor="@color/accent_indigo"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- App Widget Frame (Holds selected system widget) -->
    <FrameLayout
        android:id="@+id/widgetContainer"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_marginHorizontal="20dp"
        android:background="@color/card_bg"
        android:visibility="gone"
        app:layout_constraintEnd_toStartOf="@+id/waveGestureView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout" />

    <!-- RecyclerView for App List (Favorites + Alphabetical items) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/waveGestureView"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/widgetContainer" />

    <!-- Scrim Background Overlay for Search Focus -->
    <View
        android:id="@+id/searchScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8090A10"
        android:elevation="6dp"
        android:visibility="gone" />

    <!-- Floating Search Panel: search box + recent searches + live results.
         Sits ABOVE the scrim so results are clearly interactive. -->
    <LinearLayout
        android:id="@+id/searchPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/search_panel_bg"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0">

        <!-- Search input box -->
        <LinearLayout
            android:id="@+id/searchContainer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/search_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="18dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_search"
                app:tint="@color/text_muted" />

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/hint_search"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Recently searched apps (quick re-launch chips) -->
        <HorizontalScrollView
            android:id="@+id/historyScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/historyChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- Live search results (inside the panel, clearly tappable) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchResultsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:overScrollMode="never"
            android:scrollbars="none" />

        <!-- Empty state -->
        <TextView
            android:id="@+id/txtNoResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="20dp"
            android:text="@string/search_no_results"
            android:textColor="@color/text_muted"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Large overlay letter indicator during alphabet scrubbing -->
    <TextView
        android:id="@+id/txtLetterPopup"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@android:drawable/toast_frame"
        android:backgroundTint="#d8000000"
        android:textColor="@android:color/white"
        android:textSize="48sp"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Custom View for the Wave Alphabet Gesture (Right Edge - skips top header) -->
    <com.opscalehub.slim.WaveGestureView
        android:id="@+id/waveGestureView"
        android:layout_width="36dp"
        android:layout_height="0dp"
        android:layout_marginVertical="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerLayout" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Subtle rounded card behind the hosted widget. Gives transparent widgets
     (clock, calendar) a consistent grounded surface; behind opaque widgets it's
     hidden, but the matching corner radius is what clipToOutline rounds every
     widget to, so they all share one silhouette. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#66141720" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="#12FFFFFF" />
</shape>

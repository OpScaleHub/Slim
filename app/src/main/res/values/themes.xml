<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Slim" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Make background transparent to show system wallpaper -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <!-- Translucent status and navigation bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        
        <item name="colorPrimary">@color/accent_indigo</item>
    </style>
</resources>
